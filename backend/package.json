{
	"name": "backend",
	"version": "1.0.0",
	"packageManager": "pnpm@10.33.2",
	"main": "dist/main.js",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/main.ts",
		"typecheck": "tsc --noEmit",
		"build": "rimraf dist && tsc && tsc-alias",
		"start": "node --env-file=.env dist/main.js",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"compression": "^1.8.2",
		"cors": "^2.8.6",
		"date-fns": "^4.4.0",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"helmet": "^8.3.0",
		"rimraf": "^6.1.3",
		"valibot": "^1.5.0",
		"valibot-env": "^1.0.0"
	},
	"devDependencies": {
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.4",
		"tsc-alias": "^1.9.7",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	}
}
